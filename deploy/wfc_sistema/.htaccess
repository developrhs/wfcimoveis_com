Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^api/config/ - [F,L]
RewriteRule ^api/v1/auth/login/?$ api/v1/auth-login.php [L,QSA]
RewriteRule ^api/v1/auth/me/?$ api/v1/auth-me.php [L,QSA]
RewriteRule ^api/v1/auth/logout/?$ api/v1/auth-logout.php [L,QSA]
RewriteRule ^api/v1/dashboard/summary/?$ api/v1/dashboard-summary.php [L,QSA]
RewriteRule ^api/v1/health/?$ api/v1/health.php [L,QSA]
RewriteRule ^api/v1/sync/push/?$ api/v1/sync-push.php [L,QSA]
RewriteRule ^api/v1/sync/pull/?$ api/v1/sync-pull.php [L,QSA]
RewriteRule ^api/v1/public/properties/?$ api/v1/public-properties.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
